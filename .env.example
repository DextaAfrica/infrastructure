# ==============================================================================
# Dexta Africa Enterprise Production Infrastructure Environment Template
# Copy this file to .env and configure all variables prior to deployment:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Network Routing Configuration
# ------------------------------------------------------------------------------
DOMAIN=dextaafrica.com
WWW_DOMAIN=www.dextaafrica.com
ADMIN_DOMAIN=admin.dextaafrica.com
OPS_DOMAIN=ops.dextaafrica.com
API_DOMAIN=api.dextaafrica.com

# Wildcard or base domain cookie scope for seamless SSO across subdomains (e.g. .dextaafrica.com)
COOKIE_DOMAIN=.dextaafrica.com

# Let's Encrypt Email Address for SSL renewal notifications
SSL_EMAIL=devops@dextaafrica.com

# Maintenance Mode Bypass CIDRs (comma or space separated IPs that bypass 503 maintenance page)
# Example: 197.210.55.12/32 102.89.23.4/32
MAINTENANCE_BYPASS_CIDR=

# ------------------------------------------------------------------------------
# 2. Service Repository Paths (Relative to infrastructure/ or Absolute)
# Defaults assume cloned in services/ or sibling directories
# ------------------------------------------------------------------------------
FRONTEND_PATH=./services/frontend
ADMIN_PORTAL_PATH=./services/admin-portal
BACKEND_PATH=./services/backend

# Custom Dockerfiles if non-standard (optional)
FRONTEND_DOCKERFILE=Dockerfile.prod
ADMIN_PORTAL_DOCKERFILE=Dockerfile
BACKEND_DOCKERFILE=Dockerfile

# ------------------------------------------------------------------------------
# 3. PostgreSQL Production Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=dexta_prod
POSTGRES_USER=dexta_admin
# Generate strong password: openssl rand -base64 32
POSTGRES_PASSWORD=replace_with_ultra_secure_postgres_password_2026

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache & Message Broker
# ------------------------------------------------------------------------------
# Generate strong password: openssl rand -base64 32
REDIS_PASSWORD=replace_with_ultra_secure_redis_password_2026

# ------------------------------------------------------------------------------
# 5. Go Enterprise Backend Configuration
# ------------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=info

# JWT Secret for Core Backend tokens: openssl rand -base64 48
JWT_SECRET=replace_with_strong_jwt_secret_at_least_32_characters_long
JWT_ACCESS_TOKEN_TTL=24h

# CORS Origins allowed to call the Core API (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=https://dextaafrica.com,https://www.dextaafrica.com,https://admin.dextaafrica.com,https://ops.dextaafrica.com

# Frontend Revalidation Webhook
FRONTEND_REVALIDATE_SECRET=replace_with_shared_revalidation_secret_key

# Initial Administrator Credentials (Bootstraps only if database is empty)
ADMIN_BOOTSTRAP_EMAIL=admin@dextaafrica.com
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_initial_bootstrap_password

# Cloudflare R2 / S3-Compatible Object Storage
STORAGE_ENDPOINT=https://e9b3685f470b0935209bd7e768109d2a.r2.cloudflarestorage.com
STORAGE_BUCKET=dextaafricastorage
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=https://e9b3685f470b0935209bd7e768109d2a.r2.cloudflarestorage.com/dextaafricastorage

# Optional Webhooks
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# ------------------------------------------------------------------------------
# 6. Frontend Web Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://dextaafrica.com
NEXT_PUBLIC_BACKEND_API_URL=https://api.dextaafrica.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 7. Enterprise Operations & Admin Command Portal Configuration
# ------------------------------------------------------------------------------
ADMIN_DATABASE_URL=file:/app/prisma/admin_portal.db
# Unique 64+ char cryptographic secret used for signing session tokens: openssl rand -hex 32
ADMIN_APP_SECRET=replace_with_64_character_hex_secret_for_admin_portal_sessions

# Registration Passcode for new employee account self-activation
ADMIN_REGISTRATION_PASSCODE=DEXTA-2026

# SMTP / Email Service (Routes locally to Postfix container, which relays to Brevo)
EMAIL_FROM=Dexta Operations <operations@dextaafrica.com>
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 8. Postfix & Brevo (Sendinblue) Enterprise Email Relay
# ------------------------------------------------------------------------------
# Brevo SMTP Relay Credentials (https://app.brevo.com/settings/keys/smtp)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email@dextaafrica.com
BREVO_SMTP_KEY=your_brevo_smtp_key_here
MAIL_DOMAIN=dextaafrica.com
POSTFIX_ALLOWED_NETWORKS=
