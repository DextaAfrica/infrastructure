# ==============================================================================
# Dexta Africa Enterprise Production Environment Configuration
# ==============================================================================

# Container Registry Image Tags (Default to latest main build from GHCR)
API_IMAGE=ghcr.io/dextaafrica/dexta-api:main
FRONTEND_IMAGE=ghcr.io/dextaafrica/dexta-frontend:main
ADMIN_IMAGE=ghcr.io/dextaafrica/dexta-admin:main
MAINTENANCE_IMAGE=dexta-maintenance:local

# Core Domains & URLs
DOMAIN=dextaafrica.com
FRONTEND_URL=https://dextaafrica.com
ADMIN_DOMAIN=admin.dextaafrica.com
OPS_DOMAIN=ops.dextaafrica.com
API_DOMAIN=api.dextaafrica.com
API_URL=https://api.dextaafrica.com
COOKIE_DOMAIN=.dextaafrica.com

# Core Persistence: Managed PostgreSQL Connection String
DATABASE_URL=postgresql://dexta:change_this_postgres_password@postgres:5432/dexta_prod?sslmode=disable

# Distributed Redis Cache & Sessions
REDIS_PASSWORD=change_this_strong_redis_password_2026
REDIS_URL=redis://:change_this_strong_redis_password_2026@redis:6379/0

# Security Tokens & Cryptographic Keys
JWT_SECRET=change_this_production_jwt_signing_secret_min_32_chars
ADMIN_APP_SECRET=change_this_production_admin_session_secret_min_32_chars
ADMIN_DATABASE_URL=file:/app/prisma/admin_portal.db

# CORS Allowed Origins
ALLOWED_ORIGINS=https://dextaafrica.com,https://admin.dextaafrica.com,https://ops.dextaafrica.com
